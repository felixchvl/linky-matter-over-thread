		(stroke
			(width 0)
			(type dash)
		)
		(fill
			(type none)
		)
		(uuid "f2628eda-ff9d-597e-9558-25f40c09f438")
	)
	(text "Power from the TIC (I1-A)"
		(exclude_from_sim no)
		(at 58.42 99.06 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "2870b112-0aa1-5ba5-9c26-de0c1f344ae6")
	)
	(text "TIC data receiver (PiTInfo V1.2 stage)"
		(exclude_from_sim no)
		(at 58.42 25.4 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "6f36cc2f-ef6a-5e3b-860e-952cf7a93e31")
	)
	(text "I1-I2: 50 kHz carrier, present = bit 0; 7 data bits, even parity, 1 stop;\n1200 baud (historique) or 9600 baud (standard).\nCarrier → U1 conducts → Q1 on → TIC_RX low: start/0 bits come out low, no inversion.\nRV1 is a 0-2 kΩ rheostat (PiTInfo V1.5); about 1-1.2 kΩ is reported on Linky.\nSet it before connecting: the TIC expects 500-2000 Ω at 50 kHz (Enedis-NOI-CPT_54E)."
		(exclude_from_sim no)
		(at 60.96 68.58 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "867f6ada-ecdb-51d3-b528-2bc2b63ddc75")
	)
	(text "Thread module (nRF52840)"
		(exclude_from_sim no)
		(at 208.28 25.4 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "92f74429-577c-5c5e-8d58-fc20d34c7682")
	)
	(text "Only the 28 edge pads are soldered; the 15 inner pads (12-24 and 28-42, even) stay unconnected.\nVDDH tied to VDD: normal voltage mode, DCCH unused. USB unused: VBUS to GND, D+/D- open (Nordic reference).\nY1 32.768 kHz (CL 9 pF) with C6/C7 10 pF (about 8 pF with the board), close to the Nordic reference; the 32 MHz crystal is inside the module.\nP0.30/AIN6: VIN monitor (R3/R4, VIN x 0.13). P0.13: TIC_RX (UARTE1). P0.24: debug TX. P1.10: LED. P0.02: button.\nJ2: 1 +3V3, 2 GND, 3 nRESET, 4 DBG_TX, 5 SWDIO, 6 SWDCLK (same order as the module pads)."
		(exclude_from_sim no)
		(at 210.82 154.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9dcea7df-7da5-5423-bc89-a63996ab6105")
	)
	(text "TIC supply (I1-A): 6 Vrms ±10 % at 50 kHz into 225-335 Ω, at least 130 mW;\n13 Vrms open circuit (about 18 V peak). D1+D2 form a Schottky bridge.\nD3 keeps VIN well under the 28 V maximum of U2. C1 covers the radio transmit peaks.\nJP1 fitted: powered by the TIC. JP1 removed: 3.3 V from J2, or an ammeter across JP1.\nNever feed 3.3 V into J2 with JP1 fitted."
		(exclude_from_sim no)
		(at 60.96 158.75 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c6e94302-61ab-5793-a692-0490a0fe6150")
	)
	(text "Linky TIC"
		(exclude_from_sim no)
		(at 15.24 43.18 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "d92aabde-1c71-5f5b-9dfc-55b3dc49efb3")
	)
	(text "Pin 1: A   Pin 2: I1   Pin 3: I2\nI1 in the middle: it feeds both\nthe bridge and the receiver."
		(exclude_from_sim no)
		(at 15.24 74.93 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ef7cf4c0-af22-5cc6-93e1-db1118762bf9")
	)
	(text "Mechanical"
		(exclude_from_sim no)
		(at 15.24 99.06 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "fde88e8d-0371-547c-991f-c57f41c55037")
	)
