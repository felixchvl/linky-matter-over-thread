CONFIG_ARM_MPU=y
CONFIG_GPIO=y
CONFIG_SERIAL=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
# The image starts at 0x0: there is no bootloader on this board.
CONFIG_USE_DT_CODE_PARTITION=y
# The 9 pF crystal sits on 10 pF capacitors (Nordic's reference uses 12 pF).
# The lighter load runs it about 35 ppm fast; with its 20 ppm tolerance,
# the worst case is near 57 ppm, so declare 75 ppm to the radio stacks.
CONFIG_CLOCK_CONTROL_NRF_K32SRC_75PPM=y
